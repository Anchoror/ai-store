<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <style>
      .img {
        width: 300px;
        height: 300px;
      }
    </style>
  </head>
  <body>
    <h1><%= title %></h1>

    <button id="btn">获取故事图文</button>
    <ul id="container"></ul>
  </body>

  <script>
    const btn = document.getElementById("btn");
    btn.onclick = () => {
      fetch("/api/story/gen", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          prompt: "写一个关于一只猫的故事",
        }),
      }).then((res) => {
        getList();
      });
    };

    const getList = () => {
      const container = document.getElementById("container");
      container.innerHTML = "";
      fetch("/api/story/list", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
      })
        .then((res) => res.json())
        .then((data) => {
          for (const item of data.data) {
            const video = item.result?.video;
            const imgs = item.result.img.map((img) => {
              return `<p><a href="${img}">${img}</a></p>`;
            });
            const li = document.createElement("li");
            const id = item._id;
            li.innerHTML = `
                <li>
                  <p><span>_id: ${id}</span> <button id="mix" data-id="${id}">合成</button><button id="del" data-id="${id}">删除</button> ${
              video ? `<button id="play" data-id="${id}">观看</button>` : ""
            }</p>
                  ${imgs.join("")}
                </li>
              `;
            container.appendChild(li);
          }

          const mixBtns = document.querySelectorAll("button#mix");
          mixBtns.forEach((btn) => {
            btn.onclick = handleMix;
          });
          const delBtns = document.querySelectorAll("button#del");
          delBtns.forEach((btn) => {
            btn.onclick = handleDel;
          });
          const playBtns = document.querySelectorAll("button#play");
          playBtns.forEach((btn) => {
            btn.onclick = handlePlay;
          });
        });
    };
    const handleMix = (e) => {
      console.log(e);
      const id = e.target.dataset.id;
      fetch("/api/story/mix", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          id,
        }),
      })
        .then((res) => res.json())
        .then((data) => {
          getList();
        });
    };

    const handleDel = (e) => {
      console.log(e);
      const id = e.target.dataset.id;
      fetch("/api/story/del", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          id,
        }),
      })
        .then((res) => res.json())
        .then((data) => {
          getList();
        });
    };

    const handlePlay = (e) => {
      const id = e.target.dataset.id;
      let video = document.querySelector("video");
      if (video) {
        video.remove();
      }
      video = document.createElement("video");
      video.src = `/itv/video_${id}.mp4`;
      video.controls = true;
      video.autoplay = true;
      video.style = "width: 100vw;aspect-ratio: 16 / 9;background: #000";
      document.body.appendChild(video);
    };

    getList();
  </script>
</html>
